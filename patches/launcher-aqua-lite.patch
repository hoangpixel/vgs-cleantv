+        assertTrue(changed>0&&changed<480*270*4/100);
+        assertEquals(28,CosmicPlusDecor.starCount());assertEquals(58,2*CosmicPlusDecor.R);
+        assertEquals(413,CosmicPlusDecor.CX);assertEquals(104,CosmicPlusDecor.CY);
+        assertEquals(19,CosmicPlusDecor.CY-CosmicPlusDecor.R-CosmicPlusDecor.HALO-48);
+    }
+
+    @Test public void staticPixelsRepeatAndMirrorInRtl() {
