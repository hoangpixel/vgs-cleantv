@@ -0,0 +1,27 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.util.TypedValue;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/** Applied once after the existing date_below_clock layout, only for the cosmic preset. */
+final class AquaHeader {
+    private AquaHeader() { }
+
+    static void apply(Activity activity) {
+        TextView greeting = activity.findViewById(R.id.greeting);
+        if (!(greeting.getParent() instanceof LinearLayout)) return;
+        LinearLayout column = (LinearLayout) greeting.getParent();
+        LinearLayout.LayoutParams lp = (LinearLayout.LayoutParams) greeting.getLayoutParams();
+        column.removeView(greeting);
+        lp.width = ViewGroup.LayoutParams.MATCH_PARENT;
+        lp.topMargin = Math.round(6 * activity.getResources().getDisplayMetrics().density);
+        lp.bottomMargin = 0;
+        // Clock row, date/lunar column, then greeting. Retain single-line/ellipsis and the Vietnamese font.
+        column.addView(greeting, lp);
+        greeting.setAutoSizeTextTypeUniformWithConfiguration(11, 12, 1, TypedValue.COMPLEX_UNIT_SP);
+        greeting.setAlpha(0.82f);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AquaSurface.java b/launcher/app/src/main/java/com/gathin/tvhome/AquaSurface.java
new file mode 100644
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AquaSurface.java
@@ -0,0 +1,156 @@
+package com.gathin.tvhome;
+
+/** Static ARGB compositing shared by the Android texture and host-side rendering checks. */
+final class AquaSurface {
+    static final int WIDTH = 480, HEIGHT = 270;
+    static final int DEFAULT_ACCENT = 0xFF80DEDA;
+    private final int navy, night, teal, aqua;
+    private boolean galaxy;
+    private boolean cosmic;
+    private boolean cosmicPlus;
+    private int darkTeal, galaxyGlow, indigo;
+
+    static AquaSurface galaxy(int navy, int night, int darkTeal, int ocean, int glow, int indigo, int accent) {
+        AquaSurface result = new AquaSurface(navy, night, ocean, accent);
+        result.galaxy = true;
+        result.darkTeal = darkTeal | 0xFF000000;
+        result.galaxyGlow = glow | 0xFF000000;
+        result.indigo = indigo | 0xFF000000;
+        return result;
+    }
+
+    AquaSurface(int navy, int night, int teal, int aqua) {
+        this.navy = navy | 0xFF000000;
+        this.night = night | 0xFF000000;
+        this.teal = teal | 0xFF000000;
+        this.aqua = aqua == 0 ? DEFAULT_ACCENT : aqua | 0xFF000000;
+    }
+
+    AquaSurface withCosmicDecor() {
+        cosmic = galaxy;
+        cosmicPlus = false;
+        return this;
+    }
+
+    AquaSurface withCosmicPlusDecor() {
+        cosmic = galaxy;
+        cosmicPlus = galaxy;
+        return this;
+    }
+
+    int[] pixels(boolean rtl) {
+        int[] pixels = new int[WIDTH * HEIGHT];
+        if (galaxy) {
+            // Expensive curve work once per column, not once per pixel. No work during focus/rendering.
+            for (int x = 0; x < WIDTH; x++) {
+                float u = (rtl ? WIDTH - 1 - x : x) / (float) (WIDTH - 1);
+                float path = galaxyPath(u), curl = (float) Math.sin(u * 13f + 2f);
+                for (int y = 0; y < HEIGHT; y++) {
+                    int colour = galaxyPixel(u, y / (float) (HEIGHT - 1), path, curl);
+                    pixels[y * WIDTH + x] = dither(colour, rtl ? WIDTH - 1 - x : x, y);
+                }
+            }
+            if (cosmicPlus) CosmicPlusDecor.paint(pixels, rtl, aqua);
+            else if (cosmic) CosmicDecor.paint(pixels, rtl, aqua);
+            return pixels;
+        }
+        for (int y = 0; y < HEIGHT; y++) {
+            for (int x = 0; x < WIDTH; x++) {
+                pixels[y * WIDTH + x] = pixel(x / (float) (WIDTH - 1), y / (float) (HEIGHT - 1), rtl);
+            }
+        }
+        return pixels;
+    }
+
+    /** Artwork/ambient are BELOW this scrim. Text, dock and focus remain ABOVE it. */
+    int pixel(float x, float y, boolean rtl) {
+        if (rtl) x = 1f - x;
+        if (galaxy) return galaxyPixel(x, y, galaxyPath(x), (float) Math.sin(x * 13f + 2f));
+        float dx = x - 0.85f, dy = (y - 0.22f) * HEIGHT / WIDTH;
+        float tealLight = clamp(1f - (dx * dx + dy * dy) / 0.81f);
+        int colour = alpha(teal, Math.round(180f * tealLight));
+        dx = x - 0.98f;
+        dy = (y - 0.05f) * HEIGHT / WIDTH;
+        float aquaLight = clamp(1f - (dx * dx + dy * dy) / 0.2025f);
+        colour = over(alpha(aqua, Math.round(112f * aquaLight * aquaLight)), colour);
+        // Keep white toolbar labels readable even when artwork underneath is white.
+        float topShade = 0.48f * clamp((0.35f - y) / 0.35f);
+        colour = over(alpha(night, Math.round(255f * topShade)), colour);
+        // Preserve the cinematic text-side and lower-screen shadows after applying the colour wash.
+        float leftShade = x <= 0.25f ? 0.90f : 0.90f * clamp((0.92f - x) / 0.67f);
+        colour = over(alpha(navy, Math.round(255f * leftShade)), colour);
+        float lowerShade = clamp((y - 0.38f) / 0.62f);
+        return over(alpha(night, Math.round(245f * lowerShade)), colour);
+    }
+
+    int accentColor() { return aqua; }
+
+    private static float galaxyPath(float x) {
+        return 0.68f - 0.48f * x + 0.055f * (float) Math.sin(x * 7f + 0.4f);
+    }
+
+    /** Compact smooth falloff; the texture is baked, not a live shader. */
+    private static float bell(float distance) {
+        float t = clamp(1f - distance * distance);
+        return t * t * t;
+    }
+
+    private int galaxyPixel(float x, float y, float path, float curl) {
+        int colour = alpha(night, 190);
+        float cloud = bell((x - 0.56f) / 0.63f) * bell((y - 0.48f) / 0.46f);
+        colour = over(alpha(darkTeal, Math.round(165f * cloud)), colour);
+        float blueCloud = bell((x - 0.82f) / 0.48f) * bell((y - 0.49f) / 0.28f);
+        colour = over(alpha(indigo, Math.round(140f * blueCloud)), colour);
+        float span = bell((x - 0.64f) / 0.85f);
+        float band = bell((y - path) / 0.19f) * span;
+        colour = over(alpha(teal, Math.round(190f * band)), colour);
+        // A broad cloud plus a folded wisp: avoid a single straight neon beam.
+        float fold = bell((y - path - 0.09f - 0.035f * curl) / 0.065f) * bell((x - 0.7f) / 0.55f);
+        colour = over(alpha(galaxyGlow, Math.round(65f * fold)), colour);
+        float ribbon = bell((y - path - 0.028f * curl) / 0.105f) * span;
+        colour = over(alpha(galaxyGlow, Math.round(118f * ribbon)), colour);
+        float thread = bell((y - path + 0.022f * curl) / 0.036f) * span;
+        colour = over(alpha(aqua, Math.round(40f * thread)), colour);
+        // The same protected text/toolbar/dock zones as v2.1, independent of the coloured cloud.
+        colour = over(alpha(night, Math.round(255f * 0.48f * clamp((0.35f - y) / 0.35f))), colour);
+        float left = x <= 0.25f ? 0.90f : 0.90f * clamp((0.92f - x) / 0.67f);
+        colour = over(alpha(navy, Math.round(255f * left)), colour);
+        return over(alpha(night, Math.round(245f * clamp((y - 0.38f) / 0.62f))), colour);
+    }
+
+    /** Fixed +/-1 LSB luminance dither, baked once. No random state or moving stars. */
+    private static int dither(int colour, int x, int y) {
+        int hash = x * 0x1f123bb5 ^ y * 0x5f356495;
+        hash ^= hash >>> 16;
+        hash *= 0x45d9f3b;
+        int bucket = hash >>> 30;
+        int delta = bucket == 0 ? -1 : bucket == 3 ? 1 : 0;
+        int r = Math.max(0, Math.min(255, ((colour >>> 16) & 255) + delta));
+        int g = Math.max(0, Math.min(255, ((colour >>> 8) & 255) + delta));
+        int b = Math.max(0, Math.min(255, (colour & 255) + delta));
+        return (colour & 0xFF000000) | r << 16 | g << 8 | b;
+    }
+
+    static int rimColor(int aquaAccent, int original) {
+        return aquaAccent == 0 ? original : aquaAccent | 0xFF000000;
+    }
+
+    private static float clamp(float value) { return Math.max(0f, Math.min(1f, value)); }
+    private static int alpha(int colour, int alpha) { return (colour & 0xFFFFFF) | (alpha << 24); }
+
+    /** Straight-alpha SRC_OVER. Inputs/outputs are ARGB, never tied to Android's stubbed Color API. */
+    static int over(int top, int bottom) {
+        int ta = top >>> 24, ba = bottom >>> 24;
+        int a = ta + (ba * (255 - ta) + 127) / 255;
+        if (a == 0) return 0;
+        int r = channel(top, bottom, 16, ta, ba, a);
+        int g = channel(top, bottom, 8, ta, ba, a);
+        int b = channel(top, bottom, 0, ta, ba, a);
+        return a << 24 | r << 16 | g << 8 | b;
+    }
+
+    private static int channel(int top, int bottom, int shift, int ta, int ba, int a) {
+        int numerator = ((top >> shift) & 255) * ta * 255 + ((bottom >> shift) & 255) * ba * (255 - ta);
+        return Math.min(255, (numerator + a * 127) / (a * 255));
+    }
+}
