@@ -0,0 +1,36 @@
+package com.gathin.tvhome;
+
+import android.content.res.Resources;
+import android.graphics.Bitmap;
+import android.graphics.drawable.BitmapDrawable;
+import android.view.Gravity;
+
+/** One cached coloured scrim, replacing the upstream scrim rather than adding a full-screen layer. */
+final class AquaCinematic {
+    private final AquaSurface surface;
+    private BitmapDrawable scrim;
+
+    AquaCinematic(Config config) {
+        surface = config.aquaGalaxy
+                ? AquaSurface.galaxy(config.galaxyNavy, config.galaxySpace, config.galaxyDarkTeal,
+                    config.galaxyOcean, config.galaxyGlow, config.galaxyIndigo, config.focusAccentColor)
+                : new AquaSurface(config.backgroundColor, config.aquaNightColor,
+                    config.aquaGradientColor, config.focusAccentColor);
+        if (config.aquaCosmicPlus) surface.withCosmicPlusDecor();
+        else if (config.aquaCosmic) surface.withCosmicDecor();
+    }
+
+    int accentColor() { return surface.accentColor(); }
+
+    BitmapDrawable scrim(Resources resources, boolean rtl) {
+        if (scrim == null) {
+            // Prepared only during Activity setup, never on focus or in onDraw. The View retains this texture.
+            Bitmap bitmap = Bitmap.createBitmap(surface.pixels(rtl), AquaSurface.WIDTH, AquaSurface.HEIGHT,
+                    Bitmap.Config.ARGB_8888);
+            scrim = new BitmapDrawable(resources, bitmap);
+            scrim.setFilterBitmap(true);
+            scrim.setGravity(Gravity.FILL);
+        }
+        return scrim;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AquaGreeting.java b/launcher/app/src/main/java/com/gathin/tvhome/AquaGreeting.java
