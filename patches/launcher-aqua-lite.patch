+package com.gathin.tvhome;
+
+import java.security.MessageDigest;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CosmicDecorTest {
+    private AquaSurface galaxy() { return AquaSurface.galaxy(0xFF0B2030,0xFF07121D,0xFF123F50,0xFF1A6875,0xFF52C6C6,0xFF4256A8,0xFF80DEDA); }
+
+    @Test public void galaxyV22RemainsExactlyUnchanged() throws Exception {
+        MessageDigest sha=MessageDigest.getInstance("SHA-256");
+        for(int p:galaxy().pixels(false)){sha.update((byte)(p>>>24));sha.update((byte)(p>>>16));sha.update((byte)(p>>>8));sha.update((byte)p);}
+        StringBuilder hex=new StringBuilder();for(byte b:sha.digest())hex.append(String.format("%02x",b&255));
+        assertEquals("46e44756d7cf4c920c88f5558042f2be818dda077de58e66c9d9f545aa509b84",hex.toString());
+    }
+
+    @Test public void decorStaysWithinThreePercentAndOnlyItsDeclaredRegions() {
+        int[] before=galaxy().pixels(false),after=galaxy().withCosmicDecor().pixels(false);int changed=0;
+        assertEquals(before.length,after.length);
+        for(int y=0;y<AquaSurface.HEIGHT;y++)for(int x=0;x<AquaSurface.WIDTH;x++)if(before[y*480+x]!=after[y*480+x]){
+            assertTrue(CosmicDecor.region(x,y));assertTrue(x>240);changed++;
+        }
+        assertTrue(changed>100);assertTrue(changed<480*270*3/100);
+    }
+
+    @Test public void approvedChampagnePreviewRemainsPixelIdentical() throws Exception {
+        MessageDigest sha=MessageDigest.getInstance("SHA-256");
+        for(int p:galaxy().withCosmicDecor().pixels(false)){sha.update((byte)(p>>>24));sha.update((byte)(p>>>16));sha.update((byte)(p>>>8));sha.update((byte)p);}
+        StringBuilder hex=new StringBuilder();for(byte b:sha.digest())hex.append(String.format("%02x",b&255));
+        assertEquals("61b836ba35389065601e687afa875b84e43d4556d34437179cb6fff418201885",hex.toString());
+    }
+
+    @Test public void staticDecorIsDeterministicAndMirrored() {
+        AquaSurface s=galaxy().withCosmicDecor();int[] a=s.pixels(false),b=s.pixels(true);
+        assertArrayEquals(a,s.pixels(false));
+        for(int y=0;y<270;y++)for(int x=0;x<480;x++)assertEquals(a[y*480+x],b[y*480+479-x]);
+    }
+
+    @Test public void legacyNonGalaxyDoesNotGainCosmicDecoration() {
+        int[] before=new AquaSurface(0xFF102637,0xFF091923,0xFF126A76,0xFF80DEDA).pixels(false);
+        assertArrayEquals(before,new AquaSurface(0xFF102637,0xFF091923,0xFF126A76,0xFF80DEDA).withCosmicDecor().pixels(false));
+    }
+
+    @Test public void secondaryGreetingKeepsContrastAgainstWhiteArtwork() {
+        int[] pixels=galaxy().withCosmicDecor().pixels(false);
+        for(int y=30;y<110;y+=10){
+            int bg=AquaSurface.over(pixels[y*480+50],0xFFFFFFFF);
+            int text=AquaSurface.over(0xD1FFFFFF,bg);
+            assertTrue((lum(text)+.05)/(lum(bg)+.05)>=7);
+        }
+    }
+    private static double linear(int c){double v=c/255.0;return v<=.04045?v/12.92:Math.pow((v+.055)/1.055,2.4);}
+    private static double lum(int c){return .2126*linear((c>>>16)&255)+.7152*linear((c>>>8)&255)+.0722*linear(c&255);}
+}
