+++ b/launcher/app/src/test/java/com/gathin/tvhome/AquaGreetingTest.java
@@ -0,0 +1,45 @@
+package com.gathin.tvhome;
+
+import java.util.Calendar;
+import java.util.TimeZone;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class AquaGreetingTest {
+    private Calendar local(int hour, int minute) {
+        Calendar now = Calendar.getInstance(TimeZone.getTimeZone("Asia/Ho_Chi_Minh"));
+        now.set(2026, Calendar.NOVEMBER, 1, hour, minute, 0);
+        return now;
+    }
+
+    @Test public void everyBoundaryUsesTheCorrectDayPart() {
+        for (int minute = 0; minute < 24 * 60; minute++) {
+            int hour = minute / 60;
+            String wish = hour < 5 || hour >= 22 ? "Chúc ngủ ngon."
+                    : hour < 12 ? "Chúc buổi sáng tốt lành."
+                    : hour < 17 ? "Chúc buổi chiều vui vẻ." : "Chúc buổi tối thư giãn.";
+            assertEquals("minute " + minute, "Xin chào, Ăng Hòn! " + wish,
+                    AquaGreeting.text(local(hour, minute % 60), "Ăng Hòn"));
+        }
+    }
+
+    @Test public void timeZoneChangeChangesTheGreetingAtTheSameInstant() {
+        Calendar now = local(5, 0);
+        assertTrue(AquaGreeting.text(now, "Gia đình").contains("buổi sáng"));
+        now.setTimeZone(TimeZone.getTimeZone("UTC"));
+        assertEquals("Xin chào, Gia đình! Chúc ngủ ngon.", AquaGreeting.text(now, "Gia đình"));
+    }
+
+    @Test public void nameIsTrimmedAndBlankFallsBackWithoutLosingVietnamese() {
+        assertTrue(AquaGreeting.text(local(17, 0), "  Hòn Đảo  ").startsWith("Xin chào, Hòn Đảo!"));
+        assertEquals(AquaGreeting.text(local(17, 0), "Ăng Hòn"), AquaGreeting.text(local(17, 0), "  "));
+        assertEquals(AquaGreeting.text(local(17, 0), "Ăng Hòn"), AquaGreeting.text(local(17, 0), null));
+    }
+
+    @Test public void existingMinuteTickStaysAlignedWithoutABusyLoop() {
+        assertEquals(60_000L, AquaGreeting.nextMinuteDelay(0));
+        assertEquals(1L, AquaGreeting.nextMinuteDelay(59_999));
+        assertEquals(59_999L, AquaGreeting.nextMinuteDelay(60_001));
+        assertEquals(1L, AquaGreeting.nextMinuteDelay(-1));
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/AquaSurfaceTest.java b/launcher/app/src/test/java/com/gathin/tvhome/AquaSurfaceTest.java
new file mode 100644
index 0000000..7ff7567
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/AquaSurfaceTest.java
@@ -0,0 +1,77 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class AquaSurfaceTest {
+    private final AquaSurface surface = new AquaSurface(0xFF102637, 0xFF091923, 0xFF126A76, 0xFF80DEDA);
+
+    @Test public void sourceOverHonoursAlphaAndDrawOrder() {
+        assertEquals(0xFF123456, AquaSurface.over(0, 0xFF123456));
+        assertEquals(0xFFABCDEF, AquaSurface.over(0xFFABCDEF, 0xFF123456));
+        assertEquals(0xFF80007F, AquaSurface.over(0x80FF0000, 0xFF0000FF));
+        assertNotEquals(AquaSurface.over(0x80FF0000, 0xFF0000FF), AquaSurface.over(0xFF0000FF, 0x80FF0000));
+    }
+
+    @Test public void aquaSurvivesWarmAndNeutralArtworkUnderTheScrim() {
+        int tint = surface.pixel(0.88f, 0.20f, false);
+        for (int artwork : new int[]{0xFFE04020, 0xFF999999, 0xFFFFFFFF, 0xFF101010}) {
+            int shown = AquaSurface.over(tint, artwork);
+            assertTrue("green over artwork", green(shown) > red(shown) + 20);
+            assertTrue("blue over artwork", blue(shown) > red(shown) + 20);
+        }
+    }
+
+    @Test public void centralArtworkRemainsVisibleThroughTheTint() {
+        int tint = surface.pixel(0.65f, 0.32f, false);
+        assertTrue((tint >>> 24) > 0 && (tint >>> 24) < 240);
+        assertNotEquals(AquaSurface.over(tint, 0xFFCC4422), AquaSurface.over(tint, 0xFF2244CC));
+    }
+
+    @Test public void leftTextAndLowerDockKeepContrastOverWhiteArtwork() {
+        for (float[] point : new float[][]{{0.08f, 0.12f}, {0.20f, 0.45f}, {0.15f, 0.65f}, {0.8f, 0.9f}}) {
+            int colour = AquaSurface.over(surface.pixel(point[0], point[1], false), 0xFFFFFFFF);
+            assertTrue("white text contrast at " + point[0] + "," + point[1], contrastWhite(colour) >= 7.0);
+        }
+    }
+
+    @Test public void upperToolbarKeepsContrastOverWhiteArtwork() {
+        for (float[] point : new float[][]{{0.85f, 0.05f}, {0.95f, 0.08f}, {0.75f, 0.1f}}) {
+            int colour = AquaSurface.over(surface.pixel(point[0], point[1], false), 0xFFFFFFFF);
+            assertTrue("toolbar contrast at " + point[0] + "," + point[1] + " = " + contrastWhite(colour), contrastWhite(colour) >= 4.5);
+        }
+    }
+
+    @Test public void rimIsExactAquaAndOrdinaryThemesKeepTheirColour() {
+        assertEquals(0xFF80DEDA, AquaSurface.rimColor(surface.accentColor(), 0xFFEEDDDD));
+        assertEquals(0xCCFFFFFF, AquaSurface.rimColor(0, 0xCCFFFFFF));
+        assertEquals(AquaSurface.DEFAULT_ACCENT, new AquaSurface(0, 0, 0, 0).accentColor());
+    }
+
+    @Test public void rtlMirrorsColourAndTextShadowWithoutMovingViews() {
+        assertEquals(surface.pixel(0.25f, 0.5f, false), surface.pixel(0.75f, 0.5f, true));
+        assertEquals(surface.pixel(0.75f, 0.25f, false), surface.pixel(0.25f, 0.25f, true));
+    }
+
+    @Test public void textureIsDeterministicBoundedAndHasDepth() {
+        int[] pixels = surface.pixels(false);
+        assertEquals(480 * 270, pixels.length);
+        assertArrayEquals(pixels, surface.pixels(false));
+        assertNotEquals(pixels[0], pixels[479]);
+        assertNotEquals(pixels[479], pixels[pixels.length - 1]);
+    }
+
+    @Test public void configuredPaletteChangesTheRenderedPixels() {
+        AquaSurface custom = new AquaSurface(0xFF102637, 0xFF091923, 0xFF604080, 0xFFBBAADD);
+        assertNotEquals(surface.pixel(0.9f, 0.2f, false), custom.pixel(0.9f, 0.2f, false));
+        assertEquals(0xFFBBAADD, custom.accentColor());
+    }
+
+    private static int red(int c) { return c >> 16 & 255; }
+    private static int green(int c) { return c >> 8 & 255; }
+    private static int blue(int c) { return c & 255; }
+    private static double linear(int c) { double v = c / 255.0; return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
+    private static double contrastWhite(int c) {
+        return 1.05 / (0.2126 * linear(red(c)) + 0.7152 * linear(green(c)) + 0.0722 * linear(blue(c)) + 0.05);
+    }
+}
