+++ b/launcher/app/src/main/java/com/gathin/tvhome/AquaGreeting.java
@@ -0,0 +1,22 @@
+package com.gathin.tvhome;
+
+import java.util.Calendar;
+
+/** Reads the TV's local Calendar; deliberately independent of lunar UTC offset and phone time. */
+final class AquaGreeting {
+    private AquaGreeting() { }
+
+    static String text(Calendar now, String name) {
+        String owner = name == null ? "" : name.trim();
+        if (owner.isEmpty()) owner = "Ăng Hòn";
+        int hour = now.get(Calendar.HOUR_OF_DAY);
+        String wish = hour >= 5 && hour < 12 ? "Chúc buổi sáng tốt lành."
+                : hour >= 12 && hour < 17 ? "Chúc buổi chiều vui vẻ."
+                : hour >= 17 && hour < 22 ? "Chúc buổi tối thư giãn." : "Chúc ngủ ngon.";
+        return "Xin chào, " + owner + "! " + wish;
+    }
+
+    static long nextMinuteDelay(long nowMillis) {
+        return 60_000L - Math.floorMod(nowMillis, 60_000L);
+    }
+}
