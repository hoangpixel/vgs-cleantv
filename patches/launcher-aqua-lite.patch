@@ -0,0 +1,63 @@
+package com.gathin.tvhome;
+
+import java.security.MessageDigest;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class GalaxySurfaceTest {
+    private AquaSurface galaxy(int indigo) {
+        return AquaSurface.galaxy(0xFF0B2030, 0xFF07121D, 0xFF123F50, 0xFF1A6875, 0xFF52C6C6, indigo, 0xFF80DEDA);
+    }
+
+    @Test public void legacyPresetRemainsPixelIdenticalToV21() throws Exception {
+        int[] pixels = new AquaSurface(0xFF102637, 0xFF091923, 0xFF126A76, 0xFF80DEDA).pixels(false);
+        MessageDigest sha = MessageDigest.getInstance("SHA-256");
+        for (int p : pixels) { sha.update((byte)(p >>> 24)); sha.update((byte)(p >>> 16)); sha.update((byte)(p >>> 8)); sha.update((byte)p); }
+        StringBuilder hex = new StringBuilder();
+        for (byte b : sha.digest()) hex.append(String.format("%02x", b & 255));
+        assertEquals("2e7c7a6dfc1694216a2be507312ed20dabd8e8644bf8737f20b73893b6d981c8", hex.toString());
+    }
+
+    @Test public void galaxyIsVisibleAtIdleAndSurvivesArtwork() {
+        AquaSurface s = galaxy(0xFF4256A8);
+        int tint = s.pixel(0.80f, 0.29f, false);
+        for (int input : new int[]{0xFF0B2030, 0xFFE04020, 0xFFFFFFFF, 0xFF3465AD}) {
+            int c = AquaSurface.over(tint, input);
+            assertTrue(((c >>> 8) & 255) > ((c >>> 16) & 255) + 15);
+            assertTrue((c & 255) > ((c >>> 16) & 255) + 15);
+        }
+        assertNotEquals(s.pixel(0.8f, 0.3f, false), s.pixel(0.8f, 0.65f, false));
+        assertNotEquals(AquaSurface.over(s.pixel(0.65f, 0.45f, false), 0xFFCC4422),
+                AquaSurface.over(s.pixel(0.65f, 0.45f, false), 0xFF2244CC));
+    }
+
+    @Test public void indigoIsLocalisedAndChangesTheBlueCloud() {
+        AquaSurface s = galaxy(0xFF4256A8), noIndigo = galaxy(0xFF07121D);
+        assertNotEquals(s.pixel(0.85f, 0.49f, false), noIndigo.pixel(0.85f, 0.49f, false));
+        assertEquals(s.pixel(0.1f, 0.1f, false), noIndigo.pixel(0.1f, 0.1f, false));
+    }
+
+    @Test public void galaxyProtectsTextDockAndToolbarOverWhiteArtwork() {
+        AquaSurface s = galaxy(0xFF4256A8);
+        for (float[] p : new float[][]{{0.08f,0.12f,7}, {0.20f,0.45f,7}, {0.15f,0.65f,7}, {0.8f,0.9f,7},
+                {0.85f,0.05f,4.5f}, {0.95f,0.08f,4.5f}, {0.75f,0.1f,4.5f}}) {
+            assertTrue("contrast at " + p[0] + "," + p[1], contrastWhite(AquaSurface.over(s.pixel(p[0],p[1],false),0xFFFFFFFF)) >= p[2]);
+        }
+    }
+
+    @Test public void bakedDitherIsBoundedDeterministicAndMirrored() {
+        AquaSurface s = galaxy(0xFF4256A8);
+        int[] pixels=s.pixels(false), mirrored=s.pixels(true);
+        assertEquals(480*270,pixels.length);
+        assertArrayEquals(pixels,s.pixels(false));
+        for (int y=0;y<270;y++) for (int x=0;x<480;x++) {
+            assertEquals(pixels[y*480+x],mirrored[y*480+479-x]);
+            int raw=s.pixel(x/479f,y/269f,false), baked=pixels[y*480+x];
+            assertEquals(raw>>>24,baked>>>24);
+            for (int shift:new int[]{0,8,16}) assertTrue(Math.abs(((raw>>>shift)&255)-((baked>>>shift)&255))<=1);
+        }
+    }
+
+    private static double linear(int c) { double v=c/255.0; return v<=0.04045?v/12.92:Math.pow((v+0.055)/1.055,2.4); }
+    private static double contrastWhite(int c) { return 1.05/(.2126*linear((c>>>16)&255)+.7152*linear((c>>>8)&255)+.0722*linear(c&255)+.05); }
+}
